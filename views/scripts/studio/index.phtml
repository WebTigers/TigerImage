/**
 * The image studio (TIGER-98). A prompt bar, a grid of results, and a detail drawer where the prompt
 * and parameters of any image are editable so "the same but warmer" is a tweak rather than a retype.
 *
 * Every mutation goes through /api — the same surface an agent uses, so the screen cannot drift from
 * it. No inline script or style: behaviour is in assets/js/tigerimage.studio.js.
 */
$cap = (array) $this->capability;
?>
<link rel="stylesheet" href="<?= $this->escape($this->asset('/_modules/tigerimage/css/tigerimage.studio.css')) ?>">
<?php
// The budget gauge (TIGER-105). Drawn only when something is actually capped — an uncapped budget
// has no ceiling to show a fraction of, and a full bar would be inventing one.
$spend   = (array) ($this->spend ?: []);
$binding = !empty($spend['binding']) ? (array) $spend['binding'] : null;
?>
<div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
    <div>
        <h1 class="h3 mb-1"><?= $this->escape($this->t('tigerimage.studio.title')) ?></h1>
        <p class="text-body-secondary mb-0"><?= $this->t('tigerimage.studio.subtitle') ?></p>
    </div>

    <?php if ($binding): ?>
        <?php
        // Data attributes, not an inline style: the JS owns the colour, the view owns the numbers.
        $title = $this->t($binding['limit'] === 'token' ? 'tigerimage.budget.token' : 'tigerimage.budget.org')
               . ' ' . $this->t('tigerimage.budget.estimated');
        ?>
        <div id="ti-budget" class="ti-budget"
             data-fraction="<?= $this->escape((string) $binding['fraction']) ?>"
             data-remaining="<?= $this->escape((string) $binding['remaining']) ?>"
             data-cap="<?= $this->escape((string) $binding['cap']) ?>"
             data-limit="<?= $this->escape((string) $binding['limit']) ?>"
             title="<?= $this->escape($title) ?>">
            <span class="text-body-secondary"><?= $this->escape($this->t('tigerimage.budget.label')) ?></span>
            <div class="progress ti-budget-bar" role="progressbar"
                 aria-label="<?= $this->escape($this->t('tigerimage.budget.label')) ?>"
                 aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="<?= $this->escape((string) round($binding['fraction'] * 100)) ?>">
                <div class="progress-bar ti-budget-fill" id="ti-budget-fill"></div>
            </div>
            <span class="ti-budget-text text-body-secondary" id="ti-budget-text"></span>
        </div>
    <?php endif; ?>
</div>

<div id="ti-feedback"></div>

<?php if (empty($cap['available'])): ?>
    <?php // Unavailable is not an error state to hide — it is the screen's whole message, with the fix. ?>
    <div class="alert alert-warning" role="alert">
        <h2 class="h6 mb-1"><?= $this->escape($this->t('tigerimage.studio.unavailable')) ?></h2>
        <p class="mb-0"><?= $this->escape((string) ($cap['detail'] ?? '')) ?></p>
    </div>
<?php else: ?>

<form id="ti-generate" class="card mb-4" autocomplete="off">
    <div class="card-body">
        <label class="form-label" for="ti-prompt"><?= $this->escape($this->t('tigerimage.field.prompt')) ?></label>
        <textarea class="form-control" id="ti-prompt" name="prompt" rows="2"
                  placeholder="<?= $this->escape($this->t('tigerimage.field.prompt_hint')) ?>" required></textarea>

        <div class="row g-2 mt-2">
            <div class="col-sm-4">
                <label class="form-label" for="ti-negative"><?= $this->escape($this->t('tigerimage.field.negative')) ?></label>
                <input class="form-control" id="ti-negative" name="negative" type="text">
            </div>
            <div class="col-sm-3">
                <label class="form-label" for="ti-size"><?= $this->escape($this->t('tigerimage.field.size')) ?></label>
                <select class="form-select" id="ti-size" name="size">
                    <option value="1024x1024"><?= $this->escape($this->t('tigerimage.size.square')) ?></option>
                    <option value="1536x1024"><?= $this->escape($this->t('tigerimage.size.landscape')) ?></option>
                    <option value="1024x1536"><?= $this->escape($this->t('tigerimage.size.portrait')) ?></option>
                </select>
            </div>
            <div class="col-sm-2">
                <label class="form-label" for="ti-n"><?= $this->escape($this->t('tigerimage.field.count')) ?></label>
                <select class="form-select" id="ti-n" name="n">
                    <option>1</option><option>2</option><option selected>4</option>
                </select>
            </div>
            <div class="col-sm-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit" id="ti-go">
                    <?= $this->escape($this->t('tigerimage.action.generate')) ?>
                </button>
            </div>
        </div>

        <p class="text-body-secondary mt-2 mb-0">
            <?= $this->escape($this->t('tigerimage.studio.provider_note')) ?>
            <code><?= $this->escape((string) ($cap['provider'] ?? '')) ?></code> ·
            <code><?= $this->escape((string) ($cap['model'] ?? '')) ?></code>
        </p>
    </div>
</form>

<?php
// Strings the JavaScript renders (TIGER-107).
//
// A JSON map in a DATA ATTRIBUTE, not an inline <script>: the house rule forbids inline script in a
// view, and this needs no serialiser on the server beyond json_encode and one JSON.parse on the
// client. FULL keys, not short ones, so the convention sweep that checks every emitted
// `tigerimage.*` key exists reaches the JavaScript too — a short key would have hidden it.
//
// Anything the JS puts in front of a user belongs in this list. It is the contract between the two
// files, and a test asserts the JS asks for nothing that is not here.
$jsKeys = [
    'tigerimage.action.details',
    'tigerimage.action.refine',
    'tigerimage.action.refine_from_this',
    'tigerimage.action.keep',
    'tigerimage.action.bin',
    'tigerimage.action.bin_confirm',
    'tigerimage.action.generate',
    'tigerimage.action.cancel',
    'tigerimage.state.in_media',
    'tigerimage.confirm.bin_title',
    'tigerimage.confirm.bin_body',
    'tigerimage.detail.title',
    'tigerimage.detail.prompt',
    'tigerimage.detail.alt',
    'tigerimage.detail.how_made',
    'tigerimage.detail.provider',
    'tigerimage.detail.model',
    'tigerimage.detail.size',
    'tigerimage.detail.lineage',
    'tigerimage.detail.lineage_note',
    'tigerimage.error.list_failed',
    'tigerimage.error.get_failed',
    'tigerimage.error.refine_failed',
    'tigerimage.error.discard_failed',
    'tigerimage.error.generation_failed',
    'tigerimage.error.promote_failed',
];
$jsStrings = [];
foreach ($jsKeys as $k) { $jsStrings[$k] = $this->t($k); }
?>
<div id="ti-strings" hidden
     data-strings="<?= $this->escape(json_encode($jsStrings, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)) ?>"></div>

<?php // The grid. Populated from /api; each tile carries its own id so refine/promote/discard work per-image. ?>
<div id="ti-grid" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3" aria-live="polite"></div>

<div id="ti-empty" class="text-center text-body-secondary py-5 d-none">
    <?= $this->escape($this->t('tigerimage.studio.empty')) ?>
</div>

<?php // In-app modal, never window.confirm — house rule. ?>
<div class="modal fade" id="ti-confirm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="ti-confirm-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="<?= $this->escape($this->t('core.common.close')) ?>"></button>
            </div>
            <div class="modal-body"><p id="ti-confirm-body" class="mb-0"></p></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <?= $this->escape($this->t('tigerimage.action.cancel')) ?>
                </button>
                <button type="button" class="btn btn-danger" id="ti-confirm-ok"></button>
            </div>
        </div>
    </div>
</div>

<?php
// The detail drawer: prompt + parameters, editable, with refine-from-here. Markup lives in the JS
// template so one tile and the drawer cannot describe an image differently.
?>
<div class="offcanvas offcanvas-end" tabindex="-1" id="ti-detail" style="--bs-offcanvas-width:34rem;">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title h5" id="ti-detail-title"></h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                aria-label="<?= $this->escape($this->t('core.common.close')) ?>"></button>
    </div>
    <div class="offcanvas-body" id="ti-detail-body"></div>
</div>

<?php endif; ?>

<script src="<?= $this->escape($this->asset('/_modules/tigerimage/js/tigerimage.gauge.js')) ?>" defer></script>
<script src="<?= $this->escape($this->asset('/_modules/tigerimage/js/tigerimage.studio.js')) ?>" defer></script>
